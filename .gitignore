# Build output — build/ matches at any depth, unlike the anchored /build that
# only ever covered the repo root and the old single-module layout.
build/
.gradle/
.kotlin/
.cxx
.externalNativeBuild
/captures

# Machine-local
local.properties
*.iml
.DS_Store
**/.DS_Store
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# Release signing. Never commit these.
*.jks
*.keystore
keystore.properties
signing.properties
